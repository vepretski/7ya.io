{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo '7YA proxy release: no dependency install required'",
  "buildCommand": "echo '7YA proxy release: canonical pages served by serverless repair layer'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "routes": [
    {
      "src": "/release\\.json",
      "dest": "/api/release",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/canonical?path=$1",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  ]
}
