x-width:780px;margin:27px 0 0;color:#d5e1e6;font-size:clamp(1.08rem,2vw,1.35rem);line-height:1.68}.lead strong{color:#fff}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 18px;border-radius:999px;background:linear-gradient(135deg,var(--cyan),var(--green));color:#031014;font-weight:950}.button.secondary{border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--text)}.profile{padding:24px;border:1px solid rgba(255,255,255,.17);border-radius:30px;background:linear-gradient(150deg,rgba(255,255,255,.1),rgba(255,255,255,.035));box-shadow:0 30px 90px rgba(0,0,0,.4)}.profile small{color:var(--gold);font-weight:950;letter-spacing:.1em;text-transform:uppercase}.profile h2{margin:10px 0 7px;font-size:2.25rem;letter-spacing:-.04em}.profile p{margin:0;color:var(--muted);line-height:1.6}.rows{display:grid;gap:9px;margin-top:20px}.row{display:grid;grid-template-columns:1fr auto;gap:12px;padding:12px 13px;border:1px solid var(--line);border-radius:16px;background:rgba(0,0,0,.22)}.row span{color:var(--muted)}.row b{text-align:right}.statement{margin:8px 0 58px;padding:24px;border:1px solid rgba(56,236,255,.23);border-radius:27px;background:linear-gradient(125deg,rgba(56,236,255,.08),rgba(156,255,122,.035));font-size:1.12rem;line-height:1.66}.statement strong{color:var(--cyan)}.section{padding:14px 0 52px}.label{color:var(--gold);font-size:.78rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.section h2{margin:10px 0 22px;font-size:clamp(2.35rem,6vw,5.1rem);line-height:.92;letter-spacing:-.06em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{min-height:205px;padding:23px;border:1px solid var(--line);border-radius:26px;background:var(--panel)}.card.wide{grid-column:span 2}.card .k{color:var(--cyan);font-size:.76rem;font-weight:950;letter-spacing:.1em;text-transform:uppercase}.card h3{margin:12px 0 10px;font-size:1.48rem;letter-spacing:-.03em}.card p{margin:0;color:var(--muted);line-height:1.66}.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.milestone{padding:19px;border:1px solid var(--line);border-radius:22px;background:rgba(0,0,0,.2)}.milestone b{display:block;color:var(--gold);font-size:.8rem;letter-spacing:.06em;text-transform:uppercase}.milestone strong{display:block;margin:8px 0 7px;font-size:1.1rem}.milestone p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.55}.history{margin:0 0 64px;padding:31px;border:1px solid rgba(156,255,122,.28);border-radius:30px;background:radial-gradient(circle at 100% 0%,rgba(156,255,122,.11),transparent 26rem),rgba(255,255,255,.045);display:flex;align-items:center;justify-content:space-between;gap:24px}.history h2{margin:0;font-size:clamp(2rem,4vw,3.6rem);letter-spacing:-.05em}.history p{margin:10px 0 0;max-width:720px;color:var(--muted);line-height:1.62}.footer{padding:28px 0 42px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:18px;color:var(--muted)}@media(max-width:920px){.nav{align-items:flex-start;flex-direction:column}.links{justify-content:flex-start}.hero{grid-template-columns:1fr;padding-top:52px}.grid{grid-template-columns:1fr}.card.wide{grid-column:auto}.timeline{grid-template-columns:1fr 1fr}.history{align-items:flex-start;flex-direction:column}.button{width:100%}.footer{flex-direction:column}h1{font-size:clamp(3.5rem,18vw,6.6rem)}}@media(max-width:560px){.timeline{grid-template-columns:1fr}}
