---
import { vnaAnthropographyJsonLd, vnaAnthropographySeo } from "../data/vna-anthropography-seo"

const articleJsonLd = JSON.stringify(vnaAnthropographyJsonLd)
const title =
  "Visual Narrative Anthropography: A Proposed Interdisciplinary Research Program for Analyzing the Visual Construction of Identity, Memory and Legitimacy"
const citation =
  "Vepretski, I. (2026). Visual Narrative Anthropography: A Proposed Interdisciplinary Research Program for Analyzing the Visual Construction of Identity, Memory and Legitimacy. Version 1.0. DOI pending repository deposit."

const axes = [
  ["A", "Archive", "What visual traces exist, who preserved them, and under which conditions?"],
  ["N", "Narrative", "Which story emerges from selection, order, repetition, and juxtaposition?"],
  ["T", "Territory", "Which social, institutional, and spatial worlds are represented?"],
  ["H", "Hierarchy", "Who occupies the visual center, and how is authority staged?"],
  ["R", "Ritual", "Which gestures, routines, and recurring scenes stabilize identity?"],
  ["O", "Omission", "Which people, periods, emotions, or contradictions remain absent?"],
  ["G", "Gaze", "Who looks at whom, and from which position is the viewer asked to look?"],
  ["R", "Reception", "How may different audiences decode the same visual arrangement?"],
  ["A", "Algorithm", "How do platforms rank, suppress, circulate, and reward images?"],
  ["P", "Provenance", "What are the source, date, authenticity status, and chain of custody?"],
  ["H", "Historical layer", "How does meaning change when visual traces are read across time?"],
  ["Y", "Yield", "Which effects are produced: trust, belonging, legitimacy, action, or contestation?"],
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{vnaAnthropographySeo.title}</title>
    <meta name="description" content={vnaAnthropographySeo.description} />
    <link rel="canonical" href={vnaAnthropographySeo.canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={vnaAnthropographySeo.canonicalUrl} />
    <meta property="og:title" content={vnaAnthropographySeo.title} />
    <meta property="og:description" content={vnaAnthropographySeo.description} />
    <meta property="og:image" content={vnaAnthropographySeo.ogImage} />
    <meta property="og:image:alt" content={vnaAnthropographySeo.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={vnaAnthropographySeo.title} />
    <meta name="twitter:description" content={vnaAnthropographySeo.description} />
    <meta name="twitter:image" content={vnaAnthropographySeo.ogImage} />

    <meta name="citation_title" content={title} />
    <meta name="citation_author" content="Igor Vepretski" />
    <meta name="citation_publication_date" content="2026/05/31" />
    <meta name="citation_language" content="en" />
    <meta
      name="citation_pdf_url"
      content="https://7ya.io/downloads/vna/VNA_Publication_Dossier_Igor_Vepretski_v1.0.pdf"
    />
    <meta
      name="citation_abstract"
      content="This foundational page proposes Visual Narrative Anthropography (VNA) as an interdisciplinary research program for the systematic analysis of how identities, collective memories, hierarchies, and claims to legitimacy are constructed, circulated, and contested through curated arrangements of visual traces."
    />

    <script type="application/ld+json" set:html={articleJsonLd} />

    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #070707;
        color: #f5f5f2;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 92% -8%, rgba(94, 199, 255, 0.18), transparent 27rem),
          radial-gradient(circle at 8% 15%, rgba(211, 179, 117, 0.12), transparent 23rem),
          linear-gradient(135deg, #060606 0%, #0d1114 54%, #141719 100%);
      }
      a { color: inherit; }
      main { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 28px 0 72px; }
      .topline { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 14px 0 30px; }
      .topline a { color: #b8c5cb; font-size: .78rem; font-weight: 800; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
      .topline-links { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-end; }
      .eyebrow { margin: 0 0 14px; color: #9deeff; font-size: .76rem; font-weight: 900; letter-spacing: .2em; text-transform: uppercase; }
      h1 { max-width: 1020px; margin: 0; font-size: clamp(3.5rem, 10vw, 8.8rem); letter-spacing: -.095em; line-height: .84; }
      h1 span { display: block; color: #9deeff; }
      .lede { max-width: 850px; margin-top: 30px; color: #d5e0e5; font-size: clamp(1.18rem, 2.3vw, 1.72rem); line-height: 1.5; }
      .hero-grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 20px; align-items: end; padding: 54px 0 36px; }
      .panel, .axis, .proof, .statement { border: 1px solid rgba(255,255,255,.13); background: rgba(255,255,255,.055); border-radius: 24px; }
      .panel { padding: 22px; }
      .panel strong, .panel span { display: block; }
      .panel strong { color: #9deeff; letter-spacing: .12em; font-size: .72rem; text-transform: uppercase; }
      .panel span { margin-top: 10px; color: #d4dadd; line-height: 1.55; }
      .action-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 30px; }
      .button { display: inline-flex; align-items: center; justify-content: center; padding: 13px 17px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; color: #071014; background: #f5f5f2; font-size: .88rem; font-weight: 900; text-decoration: none; }
      .button.secondary { color: #e4eef2; background: transparent; }
      section { padding-top: 72px; }
      .section-label { color: #9deeff; font-size: .72rem; font-weight: 900; letter-spacing: .2em; text-transform: uppercase; }
      h2 { margin: 10px 0 14px; font-size: clamp(2.2rem, 5vw, 4.8rem); letter-spacing: -.075em; line-height: .94; }
      .section-lede { max-width: 880px; color: #c6d1d5; font-size: 1.08rem; line-height: 1.7; }
      .statement { padding: 24px; margin-top: 24px; }
      .statement p { margin: 0; color: #d7e3e7; font-size: 1.1rem; line-height: 1.7; }
      .statement p + p { margin-top: 16px; }
      .axes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 24px; }
      .axis { min-height: 176px; padding: 18px; }
      .axis-badge { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid rgba(157,238,255,.36); border-radius: 11px; color: #9deeff; background: rgba(157,238,255,.1); font-weight: 950; }
      .axis h3 { margin: 16px 0 6px; font-size: 1rem; }
      .axis p { margin: 0; color: #b9c8ce; font-size: .88rem; line-height: 1.58; }
      .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 24px; }
      .proof { padding: 20px; }
      .proof small { color: #9deeff; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
      .proof h3 { margin: 9px 0 8px; }
      .proof p { margin: 0; color: #c3cdd1; line-height: 1.65; }
      .status { display: inline-flex; margin-top: 15px; padding: 5px 8px; border: 1px solid rgba(211,179,117,.34); border-radius: 999px; color: #e8ca8c; font-size: .68rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
      .citation { margin-top: 24px; padding: 19px; border-left: 3px solid #9deeff; background: rgba(157,238,255,.055); color: #d5e0e4; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .86rem; line-height: 1.65; }
      footer { padding-top: 78px; color: #9ca8ad; font-size: .88rem; line-height: 1.8; }
      footer a { color: #d9e8ed; }
      @media (max-width: 820px) {
        .hero-grid, .axes, .proof-grid { grid-template-columns: 1fr; }
        h1 { font-size: clamp(4rem, 18vw, 7rem); }
        .topline { align-items: flex-start; }
        .topline-links { max-width: 55%; }
      }
    </style>
  </head>
  <body>
    <main>
      <nav class="topline" aria-label="7YA research navigation">
        <a href="https://7ya.io">#7YA / Research Proof Layer</a>
        <span class="topline-links">
          <a href="https://7ya.io/igor-vepretski">Igor Vepretski</a>
          <a href="https://igorvepretski.academia.edu/" rel="me external">Academia.edu</a>
        </span>
      </nav>

      <header class="hero-grid">
        <div>
          <p class="eyebrow">Foundational research program · VNA · Version 1.0</p>
          <h1>Visual Narrative<span>Anthropography</span></h1>
          <p class="lede">
            A proposed interdisciplinary research program for analyzing how identity, memory, hierarchy, and
            legitimacy are constructed through curated visual narratives.
          </p>
          <div class="action-row">
            <a class="button" href="https://igorvepretski.academia.edu/" rel="me external" data-track="vna_academia_profile_click">
              Open academic profile
            </a>
            <a class="button secondary" href="#framework">Explore the framework</a>
          </div>
        </div>
        <aside class="panel">
          <strong>Proposed and authored by</strong>
          <span>Igor Vepretski · איגור ופרצקי<br />Independent researcher, Israel</span>
          <strong style="margin-top: 22px;">Academic status</strong>
          <span>Foundational concept paper prepared for repository deposit, citation, critique, empirical testing, and peer review.</span>
        </aside>
      </header>

      <section aria-labelledby="positioning-title">
        <p class="section-label">Academic positioning</p>
        <h2 id="positioning-title">A research program, not a decorative label.</h2>
        <p class="section-lede">
          VNA proposes a defined analytical object: the visual-narrative assemblage. It also proposes a basic unit
          of analysis: the anthropographic grapheme — a minimal visual sign that contributes meaning to a larger
          construction of identity, memory, hierarchy, or legitimacy.
        </p>
        <div class="statement">
          <p>
            The priority claim concerns the specific Visual Narrative Anthropography framework articulated by Igor
            Vepretski in 2026: its definition, analytical object, 12-axis codebook, research protocol, and ethical
            safeguards.
          </p>
          <p>
            The page does not claim that the bare historical word “anthropography” was coined for the first time,
            nor that academic institutions have already recognized VNA as an independent discipline.
          </p>
        </div>
      </section>

      <section id="framework" aria-labelledby="framework-title">
        <p class="section-label">ANTHRO-GRAPHY codebook</p>
        <h2 id="framework-title">12 analytical axes.</h2>
        <p class="section-lede">
          The codebook is designed to transform visual interpretation into an explicit, comparable, and testable
          analytical protocol.
        </p>
        <div class="axes">
          {axes.map(([letter, name, description]) => (
            <article class="axis">
              <span class="axis-badge">{letter}</span>
              <h3>{name}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="proof-title">
        <p class="section-label">Entity proof layer</p>
        <h2 id="proof-title">What exists, what is connected, what remains next.</h2>
        <div class="proof-grid">
          <article class="proof">
            <small>Identity</small>
            <h3>Igor Vepretski · איגור ופרצקי</h3>
            <p>The framework is publicly attributed to its author and connected to the canonical 7YA entity page.</p>
            <a class="status" href="https://7ya.io/igor-vepretski">Canonical author page</a>
          </article>
          <article class="proof">
            <small>External graph link</small>
            <h3>Academia.edu profile</h3>
            <p>The academic profile provides an external discovery node for future repository records and papers.</p>
            <a class="status" href="https://igorvepretski.academia.edu/" rel="me external">Academic profile</a>
          </article>
          <article class="proof">
            <small>Foundation dossier</small>
            <h3>Version 1.0 prepared</h3>
            <p>A publication dossier has been prepared with formal definition, literature positioning, codebook, protocol, ethics, and deposit metadata.</p>
            <span class="status">Prepared for deposit</span>
          </article>
          <article class="proof">
            <small>Next scholarly milestone</small>
            <h3>Repository DOI and peer review</h3>
            <p>The next step is a public repository deposit, DOI insertion, ORCID linkage, library deposit, and journal submission.</p>
            <span class="status">DOI pending</span>
          </article>
        </div>
      </section>

      <section aria-labelledby="citation-title">
        <p class="section-label">Recommended citation</p>
        <h2 id="citation-title">Cite the proposal.</h2>
        <div class="citation">{citation}</div>
      </section>

      <footer>
        <strong>VNA · Visual Narrative Anthropography</strong><br />
        Proposed and authored by Igor Vepretski · איגור ופרצקי · 2026<br />
        Graph links: <a href="https://7ya.io">7ya.io</a> · <a href="https://7ya.io/igor-vepretski">author entity</a> ·
        <a href="https://igorvepretski.academia.edu/" rel="me external">Academia.edu</a> · <a href="https://starton.org.il">StartOn</a>
      </footer>
    </main>

    <script>
      window.dataLayer = window.dataLayer || []
      document.querySelectorAll("[data-track]").forEach((element) => {
        element.addEventListener("click", () => {
          window.dataLayer.push({ event: element.getAttribute("data-track") })
        })
      })
    </script>
  </body>
</html>
