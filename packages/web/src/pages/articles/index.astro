---
import { articles } from "../../data/7ya-knowledge-stream"

const title = "7YA Knowledge Stream"
const description =
  "Official articles, evidence notes, public updates, media intelligence, StartOn, and #7YA movement documentation."
const canonicalUrl = "https://7ya.io/articles"
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "7YA", item: "https://7ya.io/" },
    { "@type": "ListItem", position: 2, name: title, item: canonicalUrl },
  ],
})
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 7YA</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | 7YA`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://7ya.io/images/igor-vepretski-7ya-og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | 7YA`} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
    <style>
      :root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#060707;color:#f7f7f2}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 90% -10%,rgba(83,255,183,.16),transparent 26rem),radial-gradient(circle at 12% 15%,rgba(130,210,255,.14),transparent 25rem),linear-gradient(135deg,#050606 0%,#0b1010 54%,#111716 100%)}a{color:inherit}main{width:min(1160px,calc(100% - 2rem));margin:0 auto;padding:28px 0 76px}.nav{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:10px 0 42px}.nav a{color:#b6c8c4;text-decoration:none;font-size:.78rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.nav span{display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end}.eyebrow,.badge{color:#81ffc9;font-size:.72rem;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:end;padding:42px 0 52px}h1{max-width:820px;margin:10px 0 18px;font-size:clamp(3.4rem,10vw,8.2rem);letter-spacing:-.095em;line-height:.86}.lede{max-width:780px;color:#d7e2df;font-size:clamp(1.08rem,2.4vw,1.55rem);line-height:1.62}.panel,.card{border:1px solid rgba(255,255,255,.13);border-radius:26px;background:rgba(255,255,255,.055);box-shadow:0 24px 80px rgba(0,0,0,.18)}.panel{padding:24px}.panel strong{display:block;margin-bottom:10px}.panel p{margin:0;color:#c5d2cf;line-height:1.7}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card{display:grid;gap:14px;padding:24px;text-decoration:none;transition:transform .18s ease,border-color .18s ease}.card:hover{transform:translateY(-3px);border-color:rgba(129,255,201,.42)}.meta{display:flex;gap:8px;flex-wrap:wrap}.chip{display:inline-flex;align-items:center;border:1px solid rgba(129,255,201,.24);border-radius:999px;padding:5px 8px;color:#9fffd3;background:rgba(129,255,201,.07);font-size:.68rem;font-weight:950;letter-spacing:.09em;text-transform:uppercase}.card h2{margin:0;font-size:clamp(1.7rem,3.2vw,3rem);letter-spacing:-.06em;line-height:.96}.card p{margin:0;color:#cbd7d4;line-height:1.68}.cta{margin-top:4px;font-weight:950;color:#f7f7f2}.empty{padding:28px;border:1px dashed rgba(255,255,255,.18);border-radius:24px;color:#bcc9c6}footer{padding-top:62px;color:#99aaa6;font-size:.9rem;line-height:1.7}@media(max-width:820px){.hero,.grid{grid-template-columns:1fr}.nav{align-items:flex-start}.nav span{max-width:56%}h1{font-size:clamp(3.7rem,17vw,6.5rem)}}
    </style>
  </head>
  <body>
    <main>
      <nav class="nav" aria-label="7YA navigation">
        <a href="/">#7YA</a>
        <span><a href="/igor-vepretski">Igor Vepretski</a><a href="/evidence">Evidence</a><a href="/starton">StartOn</a></span>
      </nav>
      <header class="hero">
        <div>
          <p class="eyebrow">Official archive · evidence-aware publishing</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
        </div>
        <aside class="panel">
          <strong>Not a generic blog.</strong>
          <p>This is the 7YA memory engine: founder story, official notes, proof-aware updates, media intelligence, and public documentation without fake validation theater.</p>
        </aside>
      </header>
      <section class="grid" aria-label="7YA articles">
        {articles.length ? articles.map((article) => (
          <a class="card" href={article.href}>
            <div class="meta">
              <span class="chip">{article.category}</span>
              <span class="chip">{article.verificationStatus}</span>
              <span class="chip">{article.date}</span>
            </div>
            <h2>{article.title}</h2>
            <p>{article.excerpt}</p>
            <span class="cta">Read official entry →</span>
          </a>
        )) : <p class="empty">No public entries yet.</p>}
      </section>
      <footer>
        <strong>Verification rule:</strong> official 7YA material is marked as official-owned. External press is never invented. Pending claims remain pending until tied to visible evidence.
      </footer>
    </main>
  </body>
</html>
